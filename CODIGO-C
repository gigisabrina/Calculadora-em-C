#include <stdio.h>
#include <locale.h>

int main() {

    setlocale(LC_ALL, "Portuguese");

    int op;
    float num1, num2, resultado;

    printf("\n==== Calculadora ====\n\n");

    printf("Qual operação você deseja usar?\n\n");
    printf("1 - Soma (+)\n");
    printf("2 - Subtração (-)\n");
    printf("3 - Multiplicação (x)\n");
    printf("4 - Divisão (/)\n");
    printf("\nOpção: ");
    scanf("%d", &op);

    printf("\nDigite o primeiro valor: ");
    scanf("%f", &num1);

    printf("Digite o segundo valor: ");
    scanf("%f", &num2);

    if (op == 1) {
        resultado = num1 + num2;
        printf("\Esse foi o resultado:\n%.2f + %.2f = %.2f\n",
               num1, num2, resultado);
    }
    else if (op == 2) {
        resultado = num1 - num2;
        printf("\nEsse foi o resultado: %.2f - %.2f = %.2f\n",
               num1, num2, resultado);
    }
    else if (op == 3) {
        resultado = num1 * num2;
        printf("\nEsse foi o resultado: %.2f x %.2f = %.2f\n",
               num1, num2, resultado);
    }
    else if (op == 4) {
        if (num2 != 0) {
            resultado = num1 / num2;
            printf("\nEsse foi o resultado: %.2f / %.2f = %.2f\n",
                   num1, num2, resultado);
        } else {
            printf("\nErro: Tenta de novo! Não é possível dividir por zero!\n");
        }
    }
    else {
        printf("\nEssa opção é inválida! Escolha uma opção de 1 a 4 :)\n");
    }

    printf("\nObrigada por usar a Calculadora!\n");

    return 0;
}   
